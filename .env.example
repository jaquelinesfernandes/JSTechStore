# ============================================================
#  JSTechStore Brasil — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA commite o arquivo .env — ele já está no .gitignore.
# ============================================================

# ────────────────────────────────────────────────────────────
#  FONTE OLTP — PostgreSQL (Neon.tech)
#
#  Onde obter: console.neon.tech → projeto → Connection Details
#  Formato: postgresql://<user>:<password>@ep-<id>.<region>.aws.neon.tech/<dbname>?sslmode=require
#
#  Lida por: generate_data.py, generate_daily.py, extract.py
# ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxxxxxxx-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ────────────────────────────────────────────────────────────
#  CAMINHOS LOCAIS (sem valor sensível — altere se necessário)
# ────────────────────────────────────────────────────────────

# Arquivo DuckDB da camada Gold
DUCKDB_PATH=data/gold/jstechstore.duckdb

# Diretório raiz do Bronze Parquet
BRONZE_PATH=data/bronze

# Diretório raiz do Silver Parquet
SILVER_PATH=data/silver

# Diretório de backups comprimidos do Gold
GOLD_BACKUP_DIR=data/backups/gold

# ────────────────────────────────────────────────────────────
#  GCP / BigQuery + GCS  (Fase de Migração v2)
#  Onde obter:
#   - GCP_PROJECT_ID: console.cloud.google.com → selecionar projeto → ID do projeto
#   - GCS_BUCKET: nome do bucket criado na Fase 0 (sem gs://)
#   - GCP_SA_KEY_JSON: caminho para o arquivo .json da Service Account
#     OU conteúdo JSON inline (usado no GitHub Actions via secret GCP_SA_KEY)
#   - BQ_DATASET_GOLD: nome do dataset Gold no BigQuery
# ────────────────────────────────────────────────────────────
GCP_PROJECT_ID=jstechstore-data
GCS_BUCKET=jstechstore-bronze
GCP_SA_KEY_JSON=/path/to/jstechstore-sa-key.json
BQ_DATASET_GOLD=jstechstore_gold
BQ_DATASET_SILVER=jstechstore_silver
BQ_DATASET_BRONZE_EXT=jstechstore_bronze_ext
BQ_LOCATION=southamerica-east1
