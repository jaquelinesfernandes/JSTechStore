# ============================================================
#  JSTechStore Brasil — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA commite o arquivo .env — ele já está no .gitignore.
# ============================================================

# ────────────────────────────────────────────────────────────
#  SUPABASE / PostgreSQL
#  Onde obter: Supabase Dashboard → Project → Settings →
#              Database → Connection string → URI
#  Formato: postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres
# ────────────────────────────────────────────────────────────
SUPABASE_DB_URL=postgresql://postgres:SUA_SENHA@xxxxxxxxxxxx.supabase.co:5432/postgres

# ────────────────────────────────────────────────────────────
#  CAMINHOS LOCAIS (sem valor sensível — altere se necessário)
# ────────────────────────────────────────────────────────────

# Arquivo DuckDB da camada Gold
DUCKDB_PATH=data/gold/jstechstore.duckdb

# Diretório raiz do Bronze Parquet
BRONZE_PATH=data/bronze

# Diretório raiz do Silver Parquet
SILVER_PATH=data/silver

# Diretório de backups comprimidos do Gold
GOLD_BACKUP_DIR=data/backups/gold

# ────────────────────────────────────────────────────────────
#  POWER BI — On-premises Data Gateway (apenas referência)
#  Não é lida pelo Python — configurada no painel do Gateway.
# ────────────────────────────────────────────────────────────
# POWERBI_ODBC_DSN=JSTechStoreGold

# ────────────────────────────────────────────────────────────
#  NOTIFICAÇÕES (opcional — Fase 4)
# ────────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
